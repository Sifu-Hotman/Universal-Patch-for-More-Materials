<?xml version="1.0" encoding="utf-8" ?>
<!--
  Universal Patch for More Materials — ANALOGUE TRANSFERS

  NOT UNIVERSAL, and safe anyway. These nine operations name specific modded
  defs from the modlist this was generated against. If you do not run those
  mods the operations select nothing and do nothing.

  Why they exist: categorical rules cannot express a material the author gave
  to one def and withheld from a near identical one. The vanilla cooler got
  copper and lithium and no cast iron. The rules alone hand its wall mounted
  twin copper and cast iron and no lithium, which is wrong in both directions.
  Where a modded def is an exact functional twin of something he patched, it
  takes HIS material set instead, scaled by
  (target Steel / anchor Steel) ^ 0.5.

  Twins are recognised on comp PROPERTY VALUES, not statBases: a heater and a
  cooler are separated by CompProperties_TempControl energyPerSecond, +21
  against -21. thingClass tokens veto a pairing when both sides carry
  meaningful tokens and share none.

  Regenerating against your own modlist produces the equivalent entries for
  your mods. You do not need to: the rules in 01_Rules.xml already cover
  everything, just slightly less precisely for these nine.

  Generated, not hand written. Regenerate with tools/pareto.py.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>More Materials</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
      <!-- VFES_WallMountedTelevision: exact functional twin FlatscreenTelevision -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VFES_WallMountedTelevision" and not(costList/ME_Copper)]/costList</xpath>
        <value><ME_Copper>29</ME_Copper></value>
      </li>
      <!-- VFE_TableStonecutterElectric: exact functional twin FabricationBench -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VFE_TableStonecutterElectric" and not(costList/ME_BrassIngot) and not(costList/ME_Copper) and not(costList/ME_Nickel)]/costList</xpath>
        <value><ME_BrassIngot>5</ME_BrassIngot><ME_Copper>11</ME_Copper><ME_Nickel>8</ME_Nickel></value>
      </li>
      <!-- VFE_ComponentFabricationBench: exact functional twin FabricationBench -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VFE_ComponentFabricationBench" and not(costList/ME_BrassIngot) and not(costList/ME_Copper) and not(costList/ME_Nickel)]/costList</xpath>
        <value><ME_BrassIngot>7</ME_BrassIngot><ME_Copper>14</ME_Copper><ME_Nickel>11</ME_Nickel></value>
      </li>
      <!-- RT_AssemblyBench: exact functional twin FabricationBench -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RT_AssemblyBench" and not(costList/ME_BrassIngot) and not(costList/ME_Copper) and not(costList/ME_Nickel)]/costList</xpath>
        <value><ME_BrassIngot>10</ME_BrassIngot><ME_Copper>20</ME_Copper><ME_Nickel>15</ME_Nickel></value>
      </li>
      <!-- Joy_Arcade: exact functional twin TubeTelevision -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Joy_Arcade" and not(costList/ME_Copper)]/costList</xpath>
        <value><ME_Copper>8</ME_Copper></value>
      </li>
      <!-- VTE_WallHeater: exact functional twin Heater -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VTE_WallHeater" and not(costList/ME_Copper) and not(costList/ME_Nickel) and not(costList/ME_Tin)]/costList</xpath>
        <value><ME_Copper>5</ME_Copper><ME_Nickel>2</ME_Nickel><ME_Tin>3</ME_Tin></value>
      </li>
      <!-- TableBionics: exact functional twin FabricationBench -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="TableBionics" and not(costList/ME_BrassIngot) and not(costList/ME_Copper) and not(costList/ME_Nickel)]/costList</xpath>
        <value><ME_BrassIngot>7</ME_BrassIngot><ME_Copper>14</ME_Copper><ME_Nickel>11</ME_Nickel></value>
      </li>
      <!-- VTE_WallMountedCooler: exact functional twin Cooler -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VTE_WallMountedCooler" and not(costList/ME_Copper) and not(costList/ME_Lithium)]/costList</xpath>
        <value><ME_Copper>4</ME_Copper><ME_Lithium>2</ME_Lithium></value>
      </li>
      <!-- VTE_WallMountedHeater: exact functional twin Heater -->
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="VTE_WallMountedHeater" and not(costList/ME_Copper) and not(costList/ME_Nickel) and not(costList/ME_Tin)]/costList</xpath>
        <value><ME_Copper>4</ME_Copper><ME_Nickel>2</ME_Nickel><ME_Tin>3</ME_Tin></value>
      </li>
      </operations>
    </match>
  </Operation>
</Patch>
